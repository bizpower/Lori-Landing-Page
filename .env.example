# Solo server: bypassa le RLS. NON esporre mai al client.
# Serve per l'area admin, la prenotazione consulenze e l'upload immagini.
SUPABASE_SERVICE_ROLE_KEY="<service role key — segreta>"


# ── Provider AI (generazione articoli, meta, FAQ, immagini) ────────
# Qualsiasi endpoint compatibile con l'API chat/completions.
# Esempio con OpenAI:
AI_GATEWAY_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="<api key del provider>"
AI_MODEL="gpt-4o"
AI_MODEL_FAST="gpt-4o-mini"
# Facoltativi, per la generazione immagini:
AI_IMAGE_URL="https://api.openai.com/v1/images/generations"
AI_IMAGE_MODEL="gpt-image-1"
